# ─── Travinno Production Environment Variables ────────────────────────────────
# Copy this file to .env and fill in your Hostinger MySQL & Cloudinary credentials.
# NEVER commit .env to Git — it is listed in .gitignore.

# ── MySQL Database (Hostinger) ─────────────────────────────────────────────────
# If running on Hostinger server (Node.js VPS/cPanel): use 'localhost' or '127.0.0.1'
# If connecting remotely (from local PC or external server):
# 1. Go to Hostinger hPanel -> Databases -> Remote MySQL
# 2. Add your IP (or % for any IP)
# 3. Use the Hostinger server IP / hostname shown in Remote MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=u123456789_your_db_user
DB_PASSWORD=your_secure_db_password
DB_NAME=u123456789_your_db_name

# ── Cloudinary Image Hosting ───────────────────────────────────────────────────
# Get these from your Cloudinary Dashboard (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Node.js / Next.js ─────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
